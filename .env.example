# Copy to .env. All keys stay on the server; nothing here is ever sent to the browser.

# --- The Odds API (https://the-odds-api.com). Required for bookmaker prices / value finder.
NBI_ODDS_API_KEY=
NBI_ODDS_REGIONS=eu,us
# Optional: restrict to specific bookmakers instead of regions, e.g. pinnacle,draftkings,fanduel
NBI_ODDS_BOOKMAKERS=
# Hard monthly credit budget (free plan: 500). Calls beyond it are refused.
NBI_ODDS_MONTHLY_CREDIT_BUDGET=500

# --- SportsDataIO (optional, paid). The free trial returns scrambled data and must not be used.
NBI_SPORTSDATAIO_KEY=

# --- Web app login (set this before the app is reachable from the internet!)
NBI_APP_PASSWORD=
# Random string; changing it logs out every device. Generate e.g. with:  openssl rand -hex 32
NBI_SESSION_SECRET=

# --- Internet server with HTTPS (docker compose --profile https up -d)
# Your domain, or without one: the server IP with dashes + .sslip.io, e.g. 203-0-113-7.sslip.io
DOMAIN=
# Port of the web app without HTTPS (home network); with the https profile you can set it to 127.0.0.1:3000
WEB_PORT=3000

# --- Internal: when set, mutating API calls need this bearer token (the web container adds it server-side).
NBI_API_TOKEN=
POSTGRES_PASSWORD=change-me

# --- Local development without Docker (defaults shown)
# NBI_DATABASE_URL=sqlite:///./data/nbi.db
# NBI_REDIS_URL=redis://localhost:6379/0
